@model RaceDay.Models.Category
@{ ViewData["Title"]="Category"; }<h1>Manage category</h1><form method="post" class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="EventId" type="hidden"/><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<RaceDay.Models.CategoryKind>()" class="form-select"></select></div><button class="btn btn-primary">Save</button></form>