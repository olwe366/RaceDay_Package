@model ParticipantDashboardViewModel
@{ ViewData["Title"]="Participant Dashboard"; }
<h1>Welcome, @Model.DisplayName</h1><p class="text-muted">Your racing journey at a glance</p>
<div class="row g-3 mb-4">@foreach(var metric in new[]{("Upcoming",Model.UpcomingCount),("Completed",Model.CompletedCount),("Results",Model.ResultsCount)}){<div class="col-md-4"><div class="card p-4"><div>@metric.Item1</div><div class="stat">@metric.Item2</div></div></div>}</div>
<h2 class="h4">My upcoming events</h2><div class="list-group mb-4">@foreach(var e in Model.Upcoming){<a class="list-group-item list-group-item-action" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName — @e.Date.ToString("dd MMM yyyy") (@e.CategoryName)</a>}</div>
<h2 class="h4">Explore available events</h2><div class="row g-3">@foreach(var e in Model.OpenEvents){<div class="col-md-6"><div class="card p-3"><h3 class="h5">@e.Name</h3><p>@e.Date.ToString("dd MMM yyyy") · @e.Location · @e.DistanceKm km</p><a class="btn btn-primary" asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">View event</a></div></div>}</div>
<a class="btn btn-outline-primary mt-4" asp-controller="Results" asp-action="My">My results</a>