@model OrganiserDashboardViewModel
@{ ViewData["Title"]="Organiser Dashboard"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><h1>Welcome, @Model.DisplayName</h1><p class="text-muted">Your event overview</p></div><a class="btn btn-primary" asp-controller="Events" asp-action="Create">+ Create event</a></div>
<div class="row g-3 mb-4">@foreach(var metric in new[]{("Total events",Model.TotalEvents),("Upcoming events",Model.UpcomingEvents),("Enrolments",Model.TotalEnrolments),("Results captured",Model.ResultsCaptured)}){<div class="col-sm-6 col-lg-3"><div class="card p-3"><div class="text-muted">@metric.Item1</div><div class="stat">@metric.Item2</div></div></div>}</div>
<h2 class="h4">Upcoming events</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model.Upcoming){<tr><td>@e.Name</td><td>@e.Date.ToString("dd MMM yyyy")</td><td>@e.EnrolmentCount</td><td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">Details</a> · <a asp-controller="Enrolments" asp-action="ForEvent" asp-route-eventId="@e.Id">Entries</a></td></tr>}</tbody></table></div>
<h2 class="h4 mt-4">Awaiting results</h2><div class="list-group">@foreach(var e in Model.AwaitingResults){<a class="list-group-item list-group-item-action" asp-controller="Results" asp-action="Capture" asp-route-eventId="@e.Id">@e.Name — capture results</a>}</div>