@model RaceDay.Models.ViewModels.CaptureResultsViewModel
@{ ViewData["Title"]="Capture Results"; }<h1>Results: @Model.EventName</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="EventId" type="hidden"/><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish time (hh:mm:ss)</th><th>Position</th></tr></thead><tbody>@for(int i=0;i<Model.Rows.Count;i++){<tr><td>@Model.Rows[i].ParticipantName<input asp-for="Rows[i].EnrolmentId" type="hidden"/></td><td>@Model.Rows[i].CategoryName</td><td><input asp-for="Rows[i].FinishTime" class="form-control" placeholder="00:45:30"/></td><td><input asp-for="Rows[i].Position" class="form-control" type="number" min="1"/></td></tr>}</tbody></table></div><button class="btn btn-primary">Save results</button></form>