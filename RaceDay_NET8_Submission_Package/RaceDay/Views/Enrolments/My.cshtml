@model IEnumerable<RaceDay.Models.Enrolment>
@{ ViewData["Title"]="My Enrolments"; }<h1>My enrolments</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var en in Model){<tr><td><a asp-controller="Events" asp-action="Details" asp-route-id="@en.EventId">@en.Event?.Name</a></td><td>@en.Event?.Date.ToString("dd MMM yyyy")</td><td>@en.Category?.Name</td><td><span class="badge bg-success">Confirmed</span></td><td>@if(en.Event?.Date > DateTime.Now && en.Result == null){<form asp-action="Withdraw" asp-route-id="@en.Id" method="post"><button class="btn btn-sm btn-outline-danger">Withdraw</button></form>}</td></tr>}</tbody></table></div>