@model RaceDay.Models.ViewModels.EnrolViewModel
@{ ViewData["Title"]="Enrol"; }<h1>Enter @Model.EventName</h1><p>@Model.EventDate.ToString("dd MMM yyyy") · @Model.Location</p><form method="post" class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="EventId" type="hidden"/><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"><option value="">Choose a category</option></select><span asp-validation-for="CategoryId" class="text-danger"></span><button class="btn btn-success mt-3">Confirm enrolment</button></form>