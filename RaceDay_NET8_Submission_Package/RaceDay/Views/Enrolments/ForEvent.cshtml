@model IEnumerable<RaceDay.Models.Enrolment>
@{ var ev=(RaceDay.Models.Event)ViewBag.Event; ViewData["Title"]="Event enrolments"; }<h1>Entries: @ev.Name</h1><a class="btn btn-primary mb-3" asp-controller="Results" asp-action="Capture" asp-route-eventId="@ev.Id">Capture results</a><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th></tr></thead><tbody>@foreach(var en in Model){<tr><td>@en.Participant?.FullName</td><td>@en.Category?.Name</td><td>@en.EnrolledOn.ToString("dd MMM yyyy")</td><td><span class="badge bg-success">Confirmed</span></td></tr>}</tbody></table></div>