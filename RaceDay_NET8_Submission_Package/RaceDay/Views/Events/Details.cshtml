@model RaceDay.Models.Event
@{ ViewData["Title"]=Model.Name; }
<a asp-action="Index">← All events</a><div class="card p-4 mt-3"><h1>@Model.Name</h1><p class="lead">@Model.Description</p><dl class="row"><dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.Date.ToString("dd MMM yyyy, HH:mm")</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd><dt class="col-sm-3">Distance</dt><dd class="col-sm-9">@Model.DistanceKm km</dd><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.EventType</dd></dl><h2 class="h5">Categories</h2><ul>@foreach(var c in Model.Categories){<li>@c.Name (@c.Kind)</li>}</ul>
<div class="d-flex flex-wrap gap-2">@if(User.IsInRole("Participant") && !(bool)(ViewBag.IsEnrolled ?? false)){<a class="btn btn-success" asp-controller="Enrolments" asp-action="Create" asp-route-eventId="@Model.Id">Enrol now</a>}
@if((bool)(ViewBag.IsOwner ?? false)){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a><a class="btn btn-outline-primary" asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.Id">Categories</a><a class="btn btn-outline-primary" asp-controller="Enrolments" asp-action="ForEvent" asp-route-eventId="@Model.Id">Enrolments</a><a class="btn btn-outline-primary" asp-controller="Results" asp-action="Capture" asp-route-eventId="@Model.Id">Results</a>}</div></div>